{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/.netlify/functions/:name", "destination": "/api/fn/:name" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/admin.html", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store" } ] },
    { "source": "/certs/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=2592000" } ] },
    { "source": "/icons/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/assets/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/starter-words.json", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] },
    { "source": "/(.*)\\.png", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/cert-render.js", "headers": [ { "key": "Cache-Control", "value": "public, max-age=86400" } ] }
  ]
}
