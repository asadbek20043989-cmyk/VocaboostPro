# --- Brauzer (Vite) uchun ochiq o'zgaruvchilar ---
# Telegram Mini App havolasi (do'stni taklif qilish tugmasi): https://t.me/BotUsername/appname
VITE_TELEGRAM_APP_LINK=""
# Firebase Realtime Database manzili (jonli reyting, sinxronlash)
VITE_FIREBASE_DB_URL=""

# --- Faqat Netlify muhit o'zgaruvchilarida (serverda) saqlanadi, kodga yozilmaydi ---
# ADMIN_CODE=maxfiy-admin-kodingiz
# FIREBASE_DB_URL=https://<loyiha>-default-rtdb.firebaseio.com
# FIREBASE_DB_SECRET=<Realtime Database secret>
# VITE_DB_PROXY_READS=0   (ixtiyoriy: 0 bo`lsa o`qish faqat to`g`ridan-to`g`ri Firebase`dan — Netlify`ga umuman tegmaydi)
# VITE_SERVER_TTS=1          (ixtiyoriy: server ovozini yoqadi; sukut bo`yicha o`chiq — kredit tejaladi)
# GEMINI_API_KEY=...                 AI (hikoya, grammatik rentgen, yozma mashq)
# GEMINI_MODEL=gemini-2.5-flash      (ixtiyoriy; ishlamasa avtomatik boshqa model sinaladi)
# BOT_TOKEN=123456:ABC...            Telegram bot tokeni (BotFather): sertifikat yuborish, eslatmalar, profil rasmi
# SITE_URL=https://saytingiz.netlify.app   (ixtiyoriy; odatda Netlify o'zi beradi) eslatma tugmasi va og-rasm uchun
# TG_WEBHOOK_SECRET=ixtiyoriy-maxfiy-satr   (faqat tg-webhook funksiyasini ulasangiz)
# TTS_VOICE=en-US-AriaNeural         (ixtiyoriy)

# Ixtiyoriy: sertifikat QR kodi ochadigan sayt manzili (bo'sh bo'lsa, joriy sayt manzili ishlatiladi)
VITE_SITE_URL=""

# --- v5: taklif tizimi va do'kon (hammasi ixtiyoriy) ---
# BOT_USERNAME=VocaBoostProBot        Bot username (@siz). Bo'sh bo'lsa admin paneldagi qiymat yoki Telegram getMe ishlatiladi
# ADMIN_CHAT_ID=123456789             Do'kondagi qo'lda beriladigan buyurtmalar (Telegram Premium/Stars) haqida xabar oladigan Telegram ID
VITE_BOT_USERNAME=""
